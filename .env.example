# ── Endpoint ─────────────────────────────────────────────────────────────────
# Which OVHcloud API to talk to. Keys are per-endpoint: a key created on ovh-eu
# is meaningless on ovh-ca.
#   ovh-eu (default) | ovh-ca | ovh-us | kimsufi-eu | kimsufi-ca
#   soyoustart-eu | soyoustart-ca
OVH_ENDPOINT=ovh-eu

# ── Auth: pick ONE method ────────────────────────────────────────────────────
#
# (A) OAuth2 client credentials — RECOMMENDED. Used automatically when both are
#     set. Create an IAM service account at
#     https://www.ovh.com/manager/#/iam/service-account, then attach a policy
#     granting the resources you need (for object storage: the public cloud
#     project, actions publicCloudProject:apiovh:*).
#     Tokens last an hour and are refreshed for you.
OVH_CLIENT_ID=
OVH_CLIENT_SECRET=

# (B) Application key + consumer key. Create the triplet in one shot at
#     https://eu.api.ovh.com/createToken/ — the access rules you list THERE are
#     fixed forever; a token cannot be widened afterwards, so grant what you
#     need up front, e.g.
#       GET  /cloud/project/*      POST /cloud/project/*
#       PUT  /cloud/project/*      DELETE /cloud/project/*
#       GET  /me
#     Requests are SHA1-signed; the server corrects for clock drift by probing
#     /auth/time once at startup.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# (C) A pre-minted access token, sent as `Authorization: Bearer`.
OVH_ACCESS_TOKEN=

# Force a method explicitly (oauth2 | signature | accessToken). Otherwise it is
# inferred from whichever variables above are set, preferring OAuth2.
OVH_AUTH_METHOD=

# ── Defaults ─────────────────────────────────────────────────────────────────
# Public cloud project — the 32-char hex `serviceName`, NOT the display name.
# Every project-scoped tool takes an optional `project` to override it.
OVH_CLOUD_PROJECT=

# Default storage region, upper-case: GRA, SBG, DE, UK, WAW, BHS...
# A bucket lives in exactly one region; the wrong one returns 404, not empty.
OVH_REGION=

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to register the WRITE tools (create/update/delete buckets, objects,
# users, credentials and policies). Off by default: only read tools exist,
# `ovh_request` is GET-only, and `ovh_presign_object` only signs GET URLs.
# Destructive tools (every delete, plus set_storage_policy, grant_bucket_access
# and provision_s3_user) additionally require an explicit `confirm: true`.
OVH_ALLOW_WRITES=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Override the API base URL entirely (a proxy, or a brand not listed above).
OVH_API_URL=

# Retry budget for 401 / 429 / 5xx responses. Defaults to 3.
OVH_MAX_RETRIES=3

# Refresh the OAuth2 token this many seconds before expiry. Defaults to 60,
# clamped to half the token's actual lifetime.
OVH_REFRESH_SKEW_SECONDS=60

# Set to 1 to log debug output to stderr.
OVH_DEBUG=
